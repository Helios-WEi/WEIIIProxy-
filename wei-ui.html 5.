
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WEI</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --bg: #08080c;
    --panel: #101017;
    --text: #f5f3ff;
    --muted: #888895;
    --purple: #9b7bff;
    --border: rgba(255,255,255,0.07);
}

body {
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    font-family: Inter, system-ui, Arial, sans-serif;
    overflow-x: hidden;
}

/* Background */

.background {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
}

.background::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
        rgba(255,255,255,0.12) 1px,
        transparent 1px
    );
    background-size: 23px 23px;
    opacity: .23;
}

.background::after {
    content: "";
    position: absolute;
    bottom: -220px;
    left: 15%;
    width: 70%;
    height: 500px;
    background: radial-gradient(
        ellipse,
        rgba(117,65,255,.24),
        rgba(54,100,255,.12),
        transparent 70%
    );
    filter: blur(90px);
}

/* Sidebar */

.sidebar {
    position: fixed;
    left: 0;
    top: 0;
    width: 76px;
    height: 100vh;
    border-right: 1px solid var(--border);
    background: rgba(9,9,13,.75);
    backdrop-filter: blur(18px);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 0;
    z-index: 10;
}

.logo {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    font-size: 18px;
    font-weight: 800;
    border-radius: 13px;
    color: white;
    background: linear-gradient(135deg,#7857f8,#b58cff);
    box-shadow: 0 0 25px rgba(139,92,246,.25);
    margin-bottom: 35px;
}

.nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.nav-item {
    width: 46px;
    height: 46px;
    border: 1px solid transparent;
    background: transparent;
    border-radius: 14px;
    color: #858592;
    font-size: 20px;
    cursor: pointer;
    transition: .25s;
    position: relative;
}

.nav-item:hover,
.nav-item.active {
    background: rgba(153,116,255,.13);
    color: #c3a8ff;
    border-color: rgba(153,116,255,.16);
    transform: translateY(-2px);
}

.nav-item[title]:hover::after {
    content: attr(title);
    position: absolute;
    left: 58px;
    top: 50%;
    transform: translateY(-50%);
    padding: 8px 12px;
    border-radius: 8px;
    background: #191922;
    color: white;
    font-size: 12px;
    white-space: nowrap;
    z-index: 50;
}

/* Main */

.main {
    margin-left: 76px;
    min-height: 100vh;
}

/* Topbar */

.topbar {
    height: 75px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 35px;
    border-bottom: 1px solid var(--border);
}

.top-label {
    font-size: 13px;
    color: var(--muted);
}

.top-right {
    display: flex;
    align-items: center;
    gap: 12px;
}

.status {
    font-size: 12px;
    color: #a5a5b2;
    border: 1px solid var(--border);
    background: rgba(255,255,255,.025);
    padding: 8px 12px;
    border-radius: 30px;
}

.status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    background: #a78bfa;
    border-radius: 50%;
    margin-right: 7px;
}

/* Content */

.content {
    max-width: 1050px;
    padding: 90px 35px 60px;
    margin: auto;
}

.hero {
    text-align: center;
    margin-bottom: 55px;
    animation: fadeUp .8s ease;
}

.hero h1 {
    font-size: clamp(60px, 10vw, 110px);
    letter-spacing: -8px;
    font-weight: 850;
    background: linear-gradient(
        180deg,
        #ffffff 15%,
        #c7b5ff 55%,
        #8764ee 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 30px rgba(140,95,255,.15));
}

.hero p {
    margin-top: 12px;
    color: #888795;
    font-size: 14px;
    letter-spacing: .4px;
}

/* Search */

.search-wrap {
    max-width: 650px;
    margin: 0 auto;
}

.search-box {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 62px;
    padding: 0 20px;
    border: 1px solid rgba(169,139,255,.17);
    border-radius: 18px;
    background: rgba(17,16,24,.8);
    backdrop-filter: blur(20px);
    transition: .3s;
    box-shadow: 0 10px 40px rgba(0,0,0,.2);
}

.search-box:focus-within {
    border-color: rgba(164,132,255,.6);
    box-shadow: 0 0 25px rgba(139,92,246,.09);
}

.search-icon {
    font-size: 19px;
    color: #8f83b8;
}

.search-box input {
    flex: 1;
    background: none;
    outline: none;
    border: none;
    color: white;
    font-size: 15px;
    min-width: 0;
}

.search-box input::placeholder {
    color: #666573;
}

.shortcut {
    font-size: 11px;
    color: #6c6b7b;
    border: 1px solid var(--border);
    padding: 5px 8px;
    border-radius: 7px;
}

/* Categories */

.categories {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 25px;
}

.category {
    border: 1px solid var(--border);
    color: #898795;
    background: rgba(255,255,255,.025);
    padding: 10px 17px;
    border-radius: 30px;
    font-size: 12px;
    cursor: pointer;
    transition: .2s;
}

.category:hover,
.category.active {
    background: rgba(151,116,255,.13);
    border-color: rgba(151,116,255,.3);
    color: #c4acff;
}

/* Section */

.section {
    margin-top: 85px;
}

.section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
}

.section-heading h2 {
    font-size: 16px;
    font-weight: 600;
}

.section-heading span {
    font-size: 12px;
    color: #757482;
}

/* Cards */

.cards {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 16px;
}

.card {
    border: 1px solid var(--border);
    border-radius: 17px;
    padding: 22px;
    background: rgba(17,16,23,.7);
    transition: .25s;
    animation: fadeUp .5s ease;
}

.card:hover {
    transform: translateY(-4px);
    border-color: rgba(157,124,255,.3);
    background: rgba(24,21,34,.9);
}

.card-icon {
    width: 43px;
    height: 43px;
    border-radius: 13px;
    display: grid;
    place-items: center;
    background: rgba(151,117,255,.12);
    margin-bottom: 18px;
    font-size: 20px;
}

.card h3 {
    font-size: 14px;
    margin-bottom: 8px;
}

.card p {
    font-size: 12px;
    color: #858391;
    line-height: 1.6;
}

.card-tag {
    display: inline-block;
    margin-top: 17px;
    font-size: 10px;
    color: #a995ff;
    background: rgba(151,117,255,.08);
    padding: 6px 9px;
    border-radius: 20px;
}

.empty {
    display: none;
    text-align: center;
    color: var(--muted);
    padding: 35px;
    font-size: 13px;
}

/* Footer */

.footer {
    text-align: center;
    padding: 55px 0 20px;
    font-size: 11px;
    color: #5f5e6c;
}

/* Animations */

@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(14px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Mobile */

@media(max-width:800px) {
    .cards {
        grid-template-columns: repeat(2,1fr);
    }

    .content {
        padding-top: 70px;
    }

    .topbar {
        padding: 0 20px;
    }
}

@media(max-width:550px) {
    .sidebar {
        width: 60px;
    }

    .main {
        margin-left: 60px;
    }

    .nav-item {
        width: 40px;
        height: 40px;
    }

    .content {
        padding: 55px 18px;
    }

    .hero h1 {
        letter-spacing: -4px;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    .shortcut {
        display: none;
    }

    .topbar {
        height: 60px;
    }

    .section {
        margin-top: 60px;
    }
}
</style>
</head>

<body>

<div class="background"></div>

<aside class="sidebar">
    <div class="logo">W</div>

    <nav class="nav">
        <button class="nav-item active" title="Home" onclick="showCategory('All',this)">⌂</button>
        <button class="nav-item" title="Games" onclick="showCategory('Games',this)">🎮</button>
        <button class="nav-item" title="Music" onclick="showCategory('Music',this)">♫</button>
        <button class="nav-item" title="Movies" onclick="showCategory('Movies',this)">▣</button>
        <button class="nav-item" title="Apps" onclick="showCategory('Apps',this)">▦</button>
        <button class="nav-item" title="Chat" onclick="showCategory('Chat',this)">◉</button>
        <button class="nav-item" title="Settings" onclick="showCategory('Settings',this)">⚙</button>
    </nav>
</aside>

<div class="main">

    <header class="topbar">
        <div class="top-label" id="pageName">Home</div>

        <div class="top-right">
            <div class="status">
                <span class="status-dot"></span>
                WEI Interface
            </div>
        </div>
    </header>

    <main class="content">

        <section class="hero">
            <h1>WEI</h1>
            <p>A little space for everything.</p>
        </section>

        <div class="search-wrap">
            <div class="search-box">
                <span class="search-icon">⌕</span>

                <input
                    type="text"
                    id="search"
                    placeholder="Search your collection..."
                    autocomplete="off"
                >

                <span class="shortcut">⌘ K</span>
            </div>

            <div class="categories">
                <button class="category active" onclick="showCategory('All',this)">All</button>
                <button class="category" onclick="showCategory('Games',this)">🎮 Games</button>
                <button class="category" onclick="showCategory('Music',this)">♫ Music</button>
                <button class="category" onclick="showCategory('Movies',this)">▣ Movies</button>
                <button class="category" onclick="showCategory('Apps',this)">▦ Apps</button>
            </div>
        </div>

        <section class="section">
            <div class="section-heading">
                <h2 id="sectionTitle">Explore</h2>
                <span id="itemCount">6 items</span>
            </div>

            <div class="cards" id="cards">

                <article class="card" data-category="Games">
                    <div class="card-icon">🎮</div>
                    <h3>Games</h3>
                    <p>Your gaming collection and favorite titles.</p>
                    <span class="card-tag">Gaming</span>
                </article>

                <article class="card" data-category="Music">
                    <div class="card-icon">♫</div>
                    <h3>Music</h3>
                    <p>Your music, playlists, and audio collection.</p>
                    <span class="card-tag">Audio</span>
                </article>

                <article class="card" data-category="Movies">
                    <div class="card-icon">▣</div>
                    <h3>Movies</h3>
                    <p>Explore films and your watchlist.</p>
                    <span class="card-tag">Cinema</span>
                </article>

                <article class="card" data-category="Apps">
                    <div class="card-icon">▦</div>
                    <h3>Apps</h3>
                    <p>Your favorite applications and tools.</p>
                    <span class="card-tag">Utilities</span>
                </article>

                <article class="card" data-category="Chat">
                    <div class="card-icon">◉</div>
                    <h3>Chat</h3>
                    <p>A place for your conversations.</p>
                    <span class="card-tag">Social</span>
                </article>

                <article class="card" data-category="Settings">
                    <div class="card-icon">⚙</div>
                    <h3>Settings</h3>
                    <p>Customize your experience.</p>
                    <span class="card-tag">Personalize</span>
                </article>

            </div>

            <div class="empty" id="empty">
                Nothing found.
            </div>
        </section>

        <footer class="footer">
            WEI · Interface Concept
        </footer>

    </main>
</div>

<script>
const search = document.getElementById("search");
const cards = document.querySelectorAll(".card");
const categories = document.querySelectorAll(".category");
const navItems = document.querySelectorAll(".nav-item");

let currentCategory = "All";

function filterCards() {
    const query = search.value.toLowerCase();
    let count = 0;

    cards.forEach(card => {
        const category = card.dataset.category;
        const text = card.innerText.toLowerCase();

        const matchesCategory =
            currentCategory === "All" ||
            category === currentCategory;

        const matchesSearch = text.includes(query);

        const visible = matchesCategory && matchesSearch;

        card.style.display = visible ? "" : "none";

        if (visible) count++;
    });

    document.getElementById("itemCount").textContent =
        count + (count === 1 ? " item" : " items");

    document.getElementById("empty").style.display =
        count === 0 ? "block" : "none";
}

function showCategory(category, clicked) {
    currentCategory = category;

    categories.forEach(btn => btn.classList.remove("active"));
    navItems.forEach(btn => btn.classList.remove("active"));

    if (clicked) clicked.classList.add("active");

    document.getElementById("pageName").textContent = category;
    document.getElementById("sectionTitle").textContent =
        category === "All" ? "Explore" : category;

    filterCards();
}

search.addEventListener("input", filterCards);

document.addEventListener("keydown", event => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        search.focus();
    }

    if (event.key === "Escape") {
        search.value = "";
        filterCards();
    }
});
</script>

</body>
</html>
